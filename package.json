{
    "name": "@supercat1337/bootstrap-esm",
    "version": "5.3.9",
    "description": "Bootstrap as ESM modules with proper tree-shaking support",
    "type": "module",
    "main": "./src/index.js",
    "module": "./src/index.js",
    "types": "./dist/types.d.ts",
    "sideEffects": [
        "src/init/**/*.js"
    ],
    "exports": {
        ".": {
            "types": "./dist/types.d.ts",
            "import": "./src/index.js"
        },
        "./alert": {
            "types": "./dist/types.d.ts",
            "import": "./src/alert.js"
        },
        "./button": {
            "types": "./dist/types.d.ts",
            "import": "./src/button.js"
        },
        "./carousel": {
            "types": "./dist/types.d.ts",
            "import": "./src/carousel.js"
        },
        "./collapse": {
            "types": "./dist/types.d.ts",
            "import": "./src/collapse.js"
        },
        "./dropdown": {
            "types": "./dist/types.d.ts",
            "import": "./src/dropdown.js"
        },
        "./modal": {
            "types": "./dist/types.d.ts",
            "import": "./src/modal.js"
        },
        "./offcanvas": {
            "types": "./dist/types.d.ts",
            "import": "./src/offcanvas.js"
        },
        "./popover": {
            "types": "./dist/types.d.ts",
            "import": "./src/popover.js"
        },
        "./scrollspy": {
            "types": "./dist/types.d.ts",
            "import": "./src/scrollspy.js"
        },
        "./tab": {
            "types": "./dist/types.d.ts",
            "import": "./src/tab.js"
        },
        "./toast": {
            "types": "./dist/types.d.ts",
            "import": "./src/toast.js"
        },
        "./tooltip": {
            "types": "./dist/types.d.ts",
            "import": "./src/tooltip.js"
        },
        "./init/alert": {
            "import": "./src/init/alert.js"
        },
        "./init/button": {
            "import": "./src/init/button.js"
        },
        "./init/carousel": {
            "import": "./src/init/carousel.js"
        },
        "./init/collapse": {
            "import": "./src/init/collapse.js"
        },
        "./init/dropdown": {
            "import": "./src/init/dropdown.js"
        },
        "./init/modal": {
            "import": "./src/init/modal.js"
        },
        "./init/offcanvas": {
            "import": "./src/init/offcanvas.js"
        },
        "./init/popover": {
            "import": "./src/init/popover.js"
        },
        "./init/scrollspy": {
            "import": "./src/init/scrollspy.js"
        },
        "./init/tab": {
            "types": "./dist/types.d.ts",
            "import": "./src/init/tab.js"
        },
        "./init/toast": {
            "import": "./src/init/toast.js"
        },
        "./init/tooltip": {
            "import": "./src/init/tooltip.js"
        }
    },
    "files": [
        "src",
        "dist"
    ],
    "scripts": {
        "build": "npm run clean && npm run create_types",
        "create_types": "tsc --project my.tsconfig.types.json && npm run bundle_types && shx rm -rf dist/types-temp",
        "bundle_types": "node scripts/bundle-types.js",
        "clean": "shx rm -rf ./dist && shx mkdir ./dist"
    },
    "peerDependencies": {
        "@popperjs/core": "^2.11.8"
    },
    "devDependencies": {
        "@popperjs/core": "^2.11.8",
        "shx": "^0.4.0"
    },
    "author": {
        "name": "Albert Bazaleev"
    },
    "license": "MIT"
}
